---
import Base from '@/layouts/Base.astro'
import Globe from '@/components/Globe.tsx'
import SocialIcons from '@/components/SocialIcons.astro'
import Clock from '@/components/Clock.tsx'
import HighlightCard from '@/components/HighlightCard.astro'
import MusicPlayer from '@/components/MusicPlayer.tsx'
import { HERO, SITE } from '@/consts'
import { getSortedPosts } from '@/lib/posts'

// Cards link straight to the external article. The /posts/<id>/ stubs still
// exist and still redirect, but they are there for inbound links from
// elsewhere — someone already on this site has no reason to bounce through one.
const highlighted = (await getSortedPosts()).filter((p) => p.data.highlight)
---
<Base>
  {/* Headroom, not taste, and it is derived — do not round it off. Manchester
      is the northernmost stop and climbs to within 53px of the top of this
      box; a popped photo reaches 150px above its marker (8px gap, then 6px of
      border, 130px of image and 6px more border). That clears the top edge by
      97px, of which the header's own py-8 donates 32px, leaving 65px for this
      margin. 80px covers it with 15px over; 64px would be a pixel short.

      So it is tied to the photo's size in src/styles/global.css and moves with
      it — every 4px added to that image needs another 4px here. Growing the
      photo without growing this lands a picture on top of the nav, and only
      while someone happens to be hovering a northern city, which is the sort
      of thing that ships.

      It has to be margin. This box is aspect-square and Tailwind is
      border-box, so padding here would hold the outer box square and shrink
      the content box instead — and since cobe sizes its backing store from
      clientWidth (square) while the canvas is CSS-stretched to fill, the globe
      would quietly render as a vertically squashed ellipse. */}
  <section class="mx-auto mt-20 aspect-square w-full max-w-[420px]">
    <Globe client:visible />
  </section>

  {/* Visually hidden, but the page still needs one: with the wordmark gone
      there is no other h1, and a document whose only headings start at h2
      reads as a fragment to screen readers and crawlers alike. */}
  <h1 class="sr-only">{SITE.title}</h1>

  <div class="mt-6 flex flex-col items-center gap-1">
    <span class="font-mono text-[10px] tracking-widest text-muted">Local Time @ {HERO.city}</span>
    <Clock client:visible />
  </div>

  <div class="mt-5 flex justify-center">
    <SocialIcons />
  </div>

  <section class="mt-12">
    <h2 class="mb-3 font-mono text-[10px] uppercase tracking-widest text-muted">Writing</h2>
    <div class="space-y-4">
      {highlighted.map((post) => (
        <HighlightCard href={post.data.externalURL} title={post.data.title} date={post.data.date} />
      ))}
    </div>
  </section>

  {/* client:visible, matching Globe and Clock: the footer is below the fold on
      every viewport, and nobody can click a record they have not scrolled to. */}
  <MusicPlayer slot="footer" client:visible />
</Base>
