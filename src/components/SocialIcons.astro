---
import { SOCIALS } from '@/consts'

/**
 * Inner SVG markup copied verbatim from
 * themes/PaperMod/layouts/partials/svg.html (the "github", "twitter" and
 * "instagram" branches), keyed by the social name used in SOCIALS. All three
 * share the same 24x24 feather-style stroke frame, so only the inner shapes
 * differ between icons.
 *
 * Only glyphs for names actually present in SOCIALS live here. A name with
 * no entry below is skipped rather than crashing the page.
 */
const ICONS: Record<string, string> = {
  github:
    '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>',
  twitter:
    '<path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>',
  instagram:
    '<rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"></line>',
}

const items = SOCIALS.filter((s) => ICONS[s.name]).map((s) => ({
  ...s,
  label: s.name.charAt(0).toUpperCase() + s.name.slice(1),
}))
---
<div class="flex gap-3">
  {items.map((s) => (
    <a
      href={s.url}
      rel="noopener noreferrer me"
      target="_blank"
      title={s.label}
      aria-label={s.label}
      class="inline-flex text-muted hover:text-fg"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-6 w-6"
        set:html={ICONS[s.name]}
      />
    </a>
  ))}
</div>
